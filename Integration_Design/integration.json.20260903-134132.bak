{
  "version": 2,
  "events": [
    {
      "event_name": "emponb_candidate_sendLink",
      "display_name": "Candidate Send/Resend Link",
      "description": "Raised explicitly by the Send/Resend Link action's business logic on a candidate record (emponb_candidate_record), so an IOFlow flow can deliver the onboarding link to the candidate. Emitted only from code (api.emit_event) \u2014 the engine does NOT auto-raise it on the action.",
      "source": {
        "type": "custom"
      },
      "params": [],
      "active": true,
      "arguments": [],
      "payload_schema": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "obj_name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "txn_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Record id (composite keys are encoded)"
          },
          "pk": {
            "type": "object",
            "description": "Primary-key column values"
          },
          "record": {
            "type": "object",
            "properties": {
              "CANDIDATE_ID": {
                "type": "string",
                "title": "Candidate ID"
              },
              "ACCESS_KEY": {
                "type": "string",
                "title": "Access Key"
              },
              "FORM_URL": {
                "type": "string",
                "title": "Form URL"
              }
            }
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          }
        }
      }
    }
  ],
  "apis": [
    {
      "api_name": "validate_pan_vayana",
      "display_name": "Validate PAN (Vayana API)",
      "description": "Synchronous PAN verification for the Candidate Onboarding Record's 'Validate PAN' action button. The engine invokes this as a sync api_call event on the project's IOFlow application; the IOFlow flow behind it calls the connected IOFlow application 'Vayana API' (operation ValidatePAN) and shapes the reply into the item_change return contract below. The flow MUST answer with {\"updates\": {...}} \u2014 the engine applies those keys straight onto the open Candidate Onboarding Record form.",
      "category": "http",
      "input_schema": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "description": "CANDIDATE_ID of the record the button was clicked on"
          },
          "pan_no": {
            "type": "string",
            "description": "PAN to verify (already checked non-blank by the action)"
          },
          "candidate_name": {
            "type": "string",
            "description": "Name on record, for the name-match comparison"
          }
        },
        "required": [
          "candidate_id",
          "pan_no"
        ]
      },
      "output_schema": {
        "type": "object",
        "description": "item_change return contract applied to the open form.",
        "properties": {
          "updates": {
            "type": "object",
            "properties": {
              "PAN_VALIDATED": {
                "type": "string",
                "enum": [
                  "Y",
                  "N"
                ],
                "description": "'Y' when Vayana confirms the PAN, else 'N'"
              },
              "PAN_VALIDATED_NAME": {
                "type": "string",
                "description": "Registered name as returned by Vayana"
              }
            },
            "required": [
              "PAN_VALIDATED"
            ]
          },
          "error": {
            "type": "string",
            "description": "Set instead of updates to fail the action with a message"
          }
        }
      },
      "sync": true,
      "active": true
    },
    {
      "api_name": "push_to_vision",
      "display_name": "Push To Vision (Vison ERP HR)",
      "description": "Synchronous employee push for the Candidate Onboarding Record's 'Push To Vision' action button. The engine invokes this as a sync api_call event on the project's IOFlow application, carrying the WHOLE record as it stands on screen: every captured header field plus the four child grids (past_experience, education, family, pay_structure) as row arrays. The IOFlow flow (emponb_push_to_vision) maps them onto Vision's emp_complete sections \u2014 Root.Detail1 (employee master), Detail2 (family), Detail4 (qualification), Detail6 (past experience) \u2014 and calls the connected IOFlow application 'Vison ERP HR' (service save_transaction, enterprise APPVIS, app ERP_HR). The flow MUST answer with {\"updates\": {...}} \u2014 the engine applies those keys straight onto the open Candidate Onboarding Record form, so the record shows STATUS 'PushedToVision' and persists it on save.",
      "category": "http",
      "input_schema": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "description": "System-generated unique candidate identifier"
          },
