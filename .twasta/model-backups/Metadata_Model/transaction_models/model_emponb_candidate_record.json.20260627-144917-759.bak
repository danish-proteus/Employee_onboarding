    ],
    "actions": [
      {
        "name": "Send/Resend Link",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "send_candidate_link",
          "description": "Generate key and send onboarding link",
          "spec": "Generate a unique ACCESS_KEY, set KEY_GENERATED_ON=now(), compute KEY_EXPIRY_DATETIME = KEY_GENERATED_ON + :key_validity_days days, set KEY_VALID_FLAG='Y', build FORM_URL (external candidate form + key), set STATUS='Link Generated', stamp STATUS_DATE and LINK_SENT_ON. Send an email to the candidate (EMAIL_ID) with the link. Return a confirmation message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Email present",
            "message": "A valid email is required before sending the link.",
            "expression": "not_empty({form.email_id}) and match({form.email_id}, \"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")"
          },
          {
            "type": "expression",
            "name": "Not confirmed",
            "message": "Cannot send a link for a confirmed/cancelled candidate.",
            "expression": "in_list({form.status}, \"Initiated,Link Generated,Link Accessed\")"
          }
        ]
      },
      {
        "name": "Re-validate PAN",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "revalidate_pan",
          "description": "Re-validate PAN via IOFLOW",
          "spec": "Invoke the IOFLOW PAN endpoint with PAN_NO; store PAN_VALIDATED and PAN_VALIDATED_NAME from the response and increment PAN_ATTEMPTS. Block the call if PAN_ATTEMPTS has reached :max_validation_attempts. Return the validation outcome message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "PAN attempts cap",
            "message": "Maximum PAN validation attempts reached.",
            "expression": "{form.pan_attempts} < {var.max_validation_attempts}"
          }
        ]
      },
      {
        "name": "Re-validate Aadhar",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "revalidate_aadhar",
          "description": "Re-validate Aadhar via IOFLOW",
          "spec": "Invoke the IOFLOW Aadhar endpoint with AADHAR_NO; store AADHAR_VALIDATED and AADHAR_VALIDATED_NAME and increment AADHAR_ATTEMPTS. Block if AADHAR_ATTEMPTS has reached :max_validation_attempts. Return the outcome message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Aadhar attempts cap",
            "message": "Maximum Aadhar validation attempts reached.",
            "expression": "{form.aadhar_attempts} < {var.max_validation_attempts}"
          }
        ]
      },
      {
        "name": "Re-validate Bank",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "revalidate_bank",
          "description": "Re-validate bank via IOFLOW",
          "spec": "Invoke the IOFLOW Bank endpoint with BANK_ACCOUNT_NO and BANK_IFSC_CODE; store BANK_VALIDATED and BANK_VALIDATED_NAME and increment BANK_ATTEMPTS. Block if BANK_ATTEMPTS has reached :max_validation_attempts. Return the outcome message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Bank attempts cap",
            "message": "Maximum bank validation attempts reached.",
            "expression": "{form.bank_attempts} < {var.max_validation_attempts}"
          }
        ]
      },
      {
        "name": "Review",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "mark_review",
          "description": "Move record to Review",
          "spec": "Set STATUS='Review' and stamp STATUS_DATE=now(). Return a confirmation message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be submitted",
            "message": "Only data-submitted candidates can be moved to Review.",
            "expression": "{form.status} == \"DataSubmitted\""
          }
        ]
      },
      {
        "name": "Confirm",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "confirm_candidate",
          "description": "Confirm and push to IOFLOW Employee",
          "spec": "Validate EMP_CODE present and unique, DATE_JOIN present, GROSS>=BASIC. Trigger the IOFLOW Employee-creation API with the consolidated employee payload (personal + finalization + pay structure rows where UPD_PAYSTRU='Y'). Store EMPLOYEE_PUSHED_FLAG='Y' and EMPLOYEE_PUSH_REF from the response. Set STATUS='Confirmed' and stamp STATUS_DATE. Send a notification to the INITIATED_BY HR user. Return a confirmation message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Status Review",
            "message": "Confirm is only allowed when status is Review.",
            "expression": "{form.status} == \"Review\""
          },
          {
            "type": "expression",
            "name": "Emp code present",
            "message": "Employee code is mandatory before Confirm.",
            "expression": "not_empty({form.emp_code})"
          },
          {
            "type": "expression",
            "name": "Date join present",
            "message": "Date of joining is mandatory before Confirm.",
            "expression": "not_empty({form.date_join})"
          },
          {
            "type": "expression",
            "name": "Gross ge basic",
            "message": "Gross must be greater than or equal to Basic.",
            "expression": "{form.gross} >= {form.basic}"
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Confirm candidate {form.candidate_name} and push to IOFLOW Employee?"
        }
      },
      {
        "name": "Cancel",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "cancel_candidate",
          "description": "Cancel the candidate record",
          "spec": "Set STATUS='Cancelled', invalidate the access key (KEY_VALID_FLAG='N'), stamp STATUS_DATE. Return a confirmation message.",
          "language": "plpgsql"
        },
        "validations": [
          {
            "type": "expression",
            "name": "Not confirmed",
            "message": "A confirmed candidate cannot be cancelled.",
            "expression": "{form.status} != \"Confirmed\""
          }
        ],
        "confirmation": {
          "mode": "reconfirm",
          "message": "Cancel onboarding for {form.candidate_name}?"
        }
      },
      {
        "name": "delete",
        "handler": "system",
        "system_op": "delete",
        "validations": [
          {
            "type": "expression",
            "name": "Deletable only when link not accessed",
            "message": "Delete is allowed only while status is Link Generated and the link has not been accessed.",
            "expression": "{form.status} == \"Link Generated\" and is_empty({form.link_accessed_on})"
          }
        ]
      }
    ],
    "cross_updates": [],
    "pre_commit": [],
    "post_commit": [],
    "follow_up_actions": [
      {
        "event": "on-add",
        "name": "init_candidate",
        "business_logic": {
          "method": "init_candidate",
          "description": "Initialise a new candidate",
          "spec": "On add/initiate, ensure CANDIDATE_ID is generated, set STATUS='Initiated' and stamp STATUS_DATE, INITIATED_BY and INITIATED_ON if not already set.",
          "language": "plpgsql"
        }
      }
    ],
    "attach_docs": [
      "PAN Document",
      "Aadhar Document",
      "Bank Document"
    ]
  }
}