          "joins": {
            "join_predicates": {
              "joins": [
                {
                  "table": "EMPONB_CANDIDATE_RECORD",
                  "main_table": true,
                  "table_descr": "Candidate onboarding main table"
                },
                {
                  "table": "EMPONB_COUNTRY_MASTER",
                  "main_table": false,
                  "table_descr": "Country master",
                  "column": "COUNTRY_CODE",
                  "join_table": "EMPONB_CANDIDATE_RECORD",
                  "join_column": "COUNTRY_CODE",
                  "join_type": "left"
                },
                {
                  "table": "EMPONB_DESIG_DEPT_MASTER",
                  "main_table": false,
                  "table_descr": "Designation/Department master",
                  "column": "DESIGN_CODE",
                  "join_table": "EMPONB_CANDIDATE_RECORD",
                  "join_column": "DESIGN_CODE",
                  "join_type": "left"
                }
              ]
            }
          },
          "validations": [
            {
              "type": "expression",
              "name": "PAN format",
              "message": "PAN must match AAAAA9999A.",
              "expression": "is_empty({form.pan_no}) or match({form.pan_no}, \"^[A-Z]{5}[0-9]{4}[A-Z]$\")"
            },
            {
              "type": "expression",
              "name": "Aadhar format",
              "message": "Aadhar must be 12 digits.",
              "expression": "is_empty({form.aadhar_no}) or match({form.aadhar_no}, \"^[0-9]{12}$\")"
            },
            {
              "type": "expression",
              "name": "IFSC format",
              "message": "IFSC must be a valid 11-char code.",
              "expression": "is_empty({form.bank_ifsc_code}) or match({form.bank_ifsc_code}, \"^[A-Z]{4}0[A-Z0-9]{6}$\")"
            },
            {
              "type": "expression",
              "name": "Mobile format",
              "message": "Mobile must be 10 digits.",
              "expression": "is_empty({form.mobile}) or match({form.mobile}, \"^[0-9]{10}$\")"
            },
            {
              "type": "expression",
              "name": "Current PIN format",
              "message": "Current PIN must be 6 digits.",
              "expression": "is_empty({form.current_pin}) or match({form.current_pin}, \"^[0-9]{6}$\")"
            },
            {
              "type": "expression",
              "name": "Permanent PIN format",
              "message": "Permanent PIN must be 6 digits.",
              "expression": "is_empty({form.permanent_pin}) or match({form.permanent_pin}, \"^[0-9]{6}$\")"
            },
            {
              "type": "expression",
              "name": "Contact email format",
              "message": "Contact person email must be valid.",
              "expression": "is_empty({form.contact_person_email}) or match({form.contact_person_email}, \"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\")"
            }
          ]
        }
      },
