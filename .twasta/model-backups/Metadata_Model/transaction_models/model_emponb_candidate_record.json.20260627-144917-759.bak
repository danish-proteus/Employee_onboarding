                "name": "status",
                "db_name": "STATUS",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Status",
                "descr": "Lifecycle status of the candidate record",
                "protect": "1",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Initiated",
                      "display": "Initiated"
                    },
                    {
                      "data": "Link Generated",
                      "display": "Link Generated"
                    },
                    {
                      "data": "Link Accessed",
                      "display": "Link Accessed"
                    },
                    {
                      "data": "DataSubmitted",
                      "display": "Data Submitted"
                    },
                    {
                      "data": "Review",
                      "display": "Review"
                    },
                    {
                      "data": "Confirmed",
                      "display": "Confirmed"
                    },
                    {
                      "data": "Cancelled",
                      "display": "Cancelled"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Initiated",
                      "color": "grey"
                    },
                    {
                      "when": "Link Generated",
                      "color": "blue"
                    },
                    {
                      "when": "Link Accessed",
                      "color": "cyan"
                    },
                    {
                      "when": "DataSubmitted",
                      "color": "amber"
                    },
                    {
                      "when": "Review",
                      "color": "purple"
                    },
                    {
                      "when": "Confirmed",
                      "color": "green"
                    },
                    {
                      "when": "Cancelled",
                      "color": "red"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "x": "90",
                "y": "90",
                "col_id": "9",
