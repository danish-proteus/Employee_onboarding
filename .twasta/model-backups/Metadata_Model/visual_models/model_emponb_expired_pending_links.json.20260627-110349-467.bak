  },
  "SOURCE_SQL": "SELECT candidate_name AS CANDIDATE_NAME, email_id AS EMAIL_ID, link_sent_on AS LINK_SENT_ON, key_expiry_datetime AS KEY_EXPIRY_DATETIME, (CURRENT_DATE - link_sent_on::date) AS DAYS_PENDING, status AS STATUS, CASE WHEN key_expiry_datetime < NOW() THEN 'EXPIRED' ELSE 'ACTIVE' END AS EXPIRY_FLAG FROM emponb_candidate_record WHERE status IN (?.status) ORDER BY key_expiry_datetime"
}
