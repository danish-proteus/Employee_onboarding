  "SOURCE_SQL": "SELECT EMPONB_CANDIDATE_RECORD.STATUS AS EMPONB_CANDIDATE_RECORD_STATUS, AVG((EMPONB_CANDIDATE_RECORD.STATUS_DATE::date - EMPONB_CANDIDATE_RECORD.INITIATED_ON::date)) AS AVG_DAYS_IN_STATUS FROM EMPONB_CANDIDATE_RECORD WHERE EMPONB_CANDIDATE_RECORD.STATUS_DATE IS NOT NULL AND EMPONB_CANDIDATE_RECORD.INITIATED_ON IS NOT NULL AND EMPONB_CANDIDATE_RECORD.STATUS IN (?.status) GROUP BY EMPONB_CANDIDATE_RECORD.STATUS ORDER BY AVG_DAYS_IN_STATUS DESC"
}
