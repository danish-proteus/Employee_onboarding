  "SOURCE_SQL": "SELECT emponb_candidate_record.status AS STATUS, COUNT(emponb_candidate_record.candidate_id) AS CANDIDATE_COUNT FROM emponb_candidate_record WHERE emponb_candidate_record.status_date BETWEEN ?.from_date AND ?.to_date GROUP BY emponb_candidate_record.status ORDER BY CANDIDATE_COUNT DESC"
}
