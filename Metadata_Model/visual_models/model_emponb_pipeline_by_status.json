  "SOURCE_SQL": "SELECT DATE_TRUNC('day', emponb_candidate_record.initiated_on)::date AS PERIOD, emponb_candidate_record.status AS STATUS, COUNT(emponb_candidate_record.candidate_id) AS CANDIDATE_COUNT FROM emponb_candidate_record WHERE emponb_candidate_record.initiated_on >= ?.from_date AND emponb_candidate_record.initiated_on <= ?.to_date AND emponb_candidate_record.design_code LIKE ?.design_code GROUP BY DATE_TRUNC('day', emponb_candidate_record.initiated_on)::date, emponb_candidate_record.status ORDER BY PERIOD, STATUS"
}