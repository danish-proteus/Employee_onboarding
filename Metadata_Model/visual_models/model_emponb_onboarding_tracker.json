  "SOURCE_SQL": "SELECT candidate_name AS CANDIDATE_NAME, email_id AS EMAIL_ID, designation AS DESIGNATION, status AS STATUS, status_date AS STATUS_DATE, link_sent_on AS LINK_SENT_ON, link_accessed_on AS LINK_ACCESSED_ON, submitted_on AS SUBMITTED_ON, key_expiry_datetime AS KEY_EXPIRY_DATETIME, initiated_by AS INITIATED_BY FROM emponb_candidate_record WHERE (?.status IS NULL OR status IN (?.status)) AND (?.initiated_by IS NULL OR initiated_by = ?.initiated_by) AND status_date::date BETWEEN ?.from_date AND ?.to_date AND (?.designation IS NULL OR designation = ?.designation) ORDER BY status_date DESC"
}