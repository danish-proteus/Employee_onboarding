  "SOURCE_SQL": "SELECT 'PAN' AS DOC_TYPE, COUNT(*) FILTER (WHERE PAN_VALIDATED = 'Y') AS VALIDATED_COUNT, COUNT(*) FILTER (WHERE COALESCE(PAN_VALIDATED,'N') = 'N' AND COALESCE(PAN_ATTEMPTS,0) > 0 AND COALESCE(PAN_ATTEMPTS,0) < 3) AS FAILED_COUNT, COUNT(*) FILTER (WHERE COALESCE(PAN_VALIDATED,'N') = 'N' AND COALESCE(PAN_ATTEMPTS,0) >= 3) AS EXHAUSTED_COUNT FROM EMPONB_CANDIDATE_RECORD UNION ALL SELECT 'AADHAR' AS DOC_TYPE, COUNT(*) FILTER (WHERE AADHAR_VALIDATED = 'Y') AS VALIDATED_COUNT, COUNT(*) FILTER (WHERE COALESCE(AADHAR_VALIDATED,'N') = 'N' AND COALESCE(AADHAR_ATTEMPTS,0) > 0 AND COALESCE(AADHAR_ATTEMPTS,0) < 3) AS FAILED_COUNT, COUNT(*) FILTER (WHERE COALESCE(AADHAR_VALIDATED,'N') = 'N' AND COALESCE(AADHAR_ATTEMPTS,0) >= 3) AS EXHAUSTED_COUNT FROM EMPONB_CANDIDATE_RECORD UNION ALL SELECT 'BANK' AS DOC_TYPE, COUNT(*) FILTER (WHERE BANK_VALIDATED = 'Y') AS VALIDATED_COUNT, COUNT(*) FILTER (WHERE COALESCE(BANK_VALIDATED,'N') = 'N' AND COALESCE(BANK_ATTEMPTS,0) > 0 AND COALESCE(BANK_ATTEMPTS,0) < 3) AS FAILED_COUNT, COUNT(*) FILTER (WHERE COALESCE(BANK_VALIDATED,'N') = 'N' AND COALESCE(BANK_ATTEMPTS,0) >= 3) AS EXHAUSTED_COUNT FROM EMPONB_CANDIDATE_RECORD"
}
