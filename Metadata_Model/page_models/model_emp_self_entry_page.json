    "actions": [
      {
        "id": "act_validate_pan",
        "name": "validate_pan",
        "description": "Validate PAN via IOFLOW proxy",
        "steps": [
          {
            "kind": "validate",
            "names": [
              "pan_no"
            ],
            "on_fail_focus": true
          },
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/validate/pan",
            "body": {
              "key": "{{access_key}}",
              "value": "{{pan_no}}"
            },
            "save_response_to": "pan_result",
            "on_success": [
              {
                "kind": "show_message",
                "level": "success",
                "text": "PAN check: {{pan_result.name_returned}} \u2014 {{pan_result.attempts_remaining}} attempts left"
              }
            ],
            "on_error": [
              {
                "kind": "set_field_error",
                "name": "pan_no",
                "message": "{{pan_result.error}}"
              },
              {
                "kind": "focus_input",
                "name": "pan_no"
              }
            ],
            "ioflow_api": "api_api_onboard_validate_pan_b7378c"
          }
        ]
      },
      {
        "id": "act_validate_aadhar",
        "name": "validate_aadhar",
        "description": "Validate Aadhaar via IOFLOW proxy",
        "steps": [
          {
            "kind": "validate",
            "names": [
              "aadhar_no"
            ],
            "on_fail_focus": true
          },
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/validate/aadhar",
            "body": {
              "key": "{{access_key}}",
              "value": "{{aadhar_no}}"
            },
            "save_response_to": "aadhar_result",
            "on_success": [
              {
                "kind": "show_message",
                "level": "success",
                "text": "Aadhaar check: {{aadhar_result.name_returned}} \u2014 {{aadhar_result.attempts_remaining}} attempts left"
              }
            ],
            "on_error": [
              {
                "kind": "set_field_error",
                "name": "aadhar_no",
                "message": "{{aadhar_result.error}}"
              },
              {
                "kind": "focus_input",
                "name": "aadhar_no"
              }
            ],
            "ioflow_api": "api_api_onboard_validate_aadhar_50098b"
          }
        ]
      },
      {
        "id": "act_validate_bank",
        "name": "validate_bank",
        "description": "Validate bank account via IOFLOW proxy",
        "steps": [
          {
            "kind": "validate",
            "names": [
              "bank_account_no",
              "bank_ifsc_code"
            ],
            "on_fail_focus": true
          },
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/validate/bank",
            "body": {
              "key": "{{access_key}}",
              "value": "{{bank_account_no}}",
              "ifsc": "{{bank_ifsc_code}}"
            },
            "save_response_to": "bank_result",
            "on_success": [
              {
                "kind": "show_message",
                "level": "success",
                "text": "Bank check: {{bank_result.name_returned}} \u2014 {{bank_result.attempts_remaining}} attempts left"
              }
            ],
            "on_error": [
              {
                "kind": "set_field_error",
                "name": "bank_account_no",
                "message": "{{bank_result.error}}"
              },
              {
                "kind": "focus_input",
                "name": "bank_account_no"
              }
            ],
            "ioflow_api": "api_api_onboard_validate_bank_fb0c23"
          }
        ]
      },
      {
        "id": "act_copy_address",
        "name": "copy_address",
        "description": "Copy current address to permanent",
        "steps": [
          {
            "kind": "set_input",
            "name": "permanent_address",
            "value": "{{current_address}}"
          },
          {
            "kind": "set_input",
            "name": "permanent_pin",
            "value": "{{current_pin}}"
          },
          {
            "kind": "set_input",
            "name": "permanent_city",
            "value": "{{current_city}}"
          },
          {
            "kind": "set_input",
            "name": "permanent_state",
            "value": "{{current_state}}"
          },
          {
            "kind": "show_message",
            "level": "info",
            "text": "Current address copied to permanent."
          }
        ]
      },
      {
        "id": "act_save_draft",
        "name": "save_draft",
        "description": "Persist a draft of the onboarding form",
        "steps": [
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/save",
            "body": {
              "key": "{{access_key}}"
            },
            "save_response_to": "save_res",
            "on_success": [
              {
                "kind": "show_message",
                "level": "success",
                "text": "Draft saved. You can return to this link and continue later."
              }
            ],
            "on_error": [
              {
                "kind": "show_message",
                "level": "error",
                "text": "Could not save draft: {{save_res.error}}"
              }
            ],
            "ioflow_api": "api_api_onboard_save_06f4e4"
          }
        ]
      },
      {
        "id": "act_submit",
        "name": "submit",
        "description": "Final submission of the onboarding form",
        "steps": [
          {
            "kind": "validate",
            "names": [
              "emp_fname",
              "emp_lname",
              "mobile",
              "pan_no",
              "aadhar_no",
              "bank_ifsc_code"
            ],
            "on_fail_focus": true
          },
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/submit",
            "body": {
              "key": "{{access_key}}"
            },
            "save_response_to": "submit_res",
            "on_success": [
              {
                "kind": "show_message",
                "level": "success",
                "text": "Thank you! Your details have been submitted. A summary has been emailed to you."
              }
            ],
            "on_error": [
              {
                "kind": "show_message",
                "level": "error",
                "text": "Submission failed: {{submit_res.error}}"
              }
            ],
            "ioflow_api": "api_api_onboard_submit_225a6e"
          }
        ]
      }
    ],
    "pageSchemaVersion": 2,
