            "fields": [
              { "id": "f_caddr", "name": "current_address", "label": "Current Address", "type": "textarea" },
              { "id": "f_cpin", "name": "current_pin", "label": "Current PIN", "type": "text" },
              { "id": "f_ccity", "name": "current_city", "label": "Current City", "type": "text" },
              { "id": "f_cstate", "name": "current_state", "label": "Current State", "type": "text" },
              { "id": "f_paddr", "name": "permanent_address", "label": "Permanent Address", "type": "textarea" },
