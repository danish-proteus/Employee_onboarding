              { "id": "f_hobby1", "name": "hobby1", "label": "Hobby 1", "type": "text" },
              { "id": "f_hobby2", "name": "hobby2", "label": "Hobby 2", "type": "text" },
              { "id": "f_totexp", "name": "total_experience", "label": "Total Experience (years)", "type": "number" }
            ]
          },
          { "id": "div_1", "type": "divider" },
          { "id": "h_address", "type": "heading", "level": 2, "text": "Address & Contact" },
          {
            "id": "btn_copy_addr",
            "type": "button",
            "align": "right",
            "button": { "id": "b_copy", "label": "Permanent same as current", "variant": "outline", "size": "sm",
              "on_click": { "kind": "run_action", "actionName": "copy_address" } }
          },
          {
            "id": "form_address",
            "type": "form",
            "heading": "",
