{
  "page": {
    "obj_name": "emponb_candidate_form",
    "title": "Candidate Onboarding Form",
    "description": "",
    "inputs": [
      {
        "name": "access_key",
        "label": "Access Key",
        "type": "text",
        "display": true,
        "default": ""
      },
      {
        "name": "key_status",
        "label": "Key Validation",
        "type": "json",
        "display": true,
        "api": {
          "method": "GET",
          "url": "/api/onboard/validate-key?key={{access_key}}",
          "autoload": true,
          "ioflow_api": "api_api_onboard_validate_key_6afd29"
        }
      },
      {
        "name": "candidate_name",
        "label": "Candidate Name",
        "type": "text",
        "display": true,
        "expression": "{{key_status.candidate_name}}"
      },
      {
        "name": "key_valid",
        "label": "Key Valid",
        "type": "text",
        "display": true,
        "expression": "{{key_status.valid}}"
      },
      {
        "name": "draft",
        "label": "Saved Draft",
        "type": "json",
        "display": true,
        "api": {
          "method": "GET",
          "url": "/api/onboard/draft?key={{access_key}}",
          "autoload": true,
          "ioflow_api": "api_api_onboard_draft_31bc88"
        }
      },
      {
        "name": "name_prefix",
        "label": "Prefix",
        "type": "select",
        "isInput": true,
        "options": [
          { "label": "Mr.", "value": "MR" },
          { "label": "Mrs.", "value": "MRS" },
          { "label": "Ms.", "value": "MS" },
          { "label": "Dr.", "value": "DR" }
        ]
      },
      {
        "name": "emp_fname",
        "label": "First Name",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "required", "message": "First name is required" } ]
      },
      {
        "name": "emp_mname",
        "label": "Middle Name",
        "type": "text",
        "isInput": true
      },
      {
        "name": "emp_lname",
        "label": "Last Name",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "required", "message": "Last name is required" } ]
      },
      {
        "name": "gender",
        "label": "Gender",
        "type": "select",
        "isInput": true,
        "options": [
          { "label": "Male", "value": "M" },
          { "label": "Female", "value": "F" },
          { "label": "Other", "value": "O" }
        ]
      },
      {
        "name": "birthdate",
        "label": "Date of Birth",
        "type": "date",
        "isInput": true
      },
      {
        "name": "nationality",
        "label": "Nationality",
        "type": "text",
        "isInput": true
      },
      {
        "name": "marital_status",
        "label": "Marital Status",
        "type": "select",
        "isInput": true,
        "options": [
          { "label": "Single", "value": "SINGLE" },
          { "label": "Married", "value": "MARRIED" },
          { "label": "Divorced", "value": "DIVORCED" },
          { "label": "Widowed", "value": "WIDOWED" }
        ]
      },
      {
        "name": "marriage_anniversary",
        "label": "Marriage Anniversary",
        "type": "date",
        "isInput": true
      },
      {
        "name": "blood_group",
        "label": "Blood Group",
        "type": "select",
        "isInput": true,
        "options": [
          { "label": "A+", "value": "A+" },
          { "label": "A-", "value": "A-" },
          { "label": "B+", "value": "B+" },
          { "label": "B-", "value": "B-" },
          { "label": "O+", "value": "O+" },
          { "label": "O-", "value": "O-" },
          { "label": "AB+", "value": "AB+" },
          { "label": "AB-", "value": "AB-" }
        ]
      },
      {
        "name": "religion",
        "label": "Religion",
        "type": "text",
        "isInput": true
      },
      {
        "name": "cast_category",
        "label": "Caste Category",
        "type": "text",
        "isInput": true
      },
      {
        "name": "mother_tongue",
        "label": "Mother Tongue",
        "type": "text",
        "isInput": true
      },
      {
        "name": "physical_handicap",
        "label": "Physically Handicapped",
        "type": "select",
        "isInput": true,
        "options": [
          { "label": "No", "value": "N" },
          { "label": "Yes", "value": "Y" }
        ]
      },
      {
        "name": "hobby1",
        "label": "Hobby 1",
        "type": "text",
        "isInput": true
      },
      {
        "name": "hobby2",
        "label": "Hobby 2",
        "type": "text",
        "isInput": true
      },
      {
        "name": "total_experience",
        "label": "Total Experience (years)",
        "type": "number",
        "isInput": true
      },
      {
        "name": "current_address",
        "label": "Current Address",
        "type": "textarea",
        "isInput": true
      },
      {
        "name": "current_pin",
        "label": "Current PIN",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[0-9]{6}$", "message": "PIN must be 6 digits" } ]
      },
      {
        "name": "current_city",
        "label": "Current City",
        "type": "text",
        "isInput": true
      },
      {
        "name": "current_state",
        "label": "Current State",
        "type": "text",
        "isInput": true
      },
      {
        "name": "permanent_address",
        "label": "Permanent Address",
        "type": "textarea",
        "isInput": true
      },
      {
        "name": "permanent_pin",
        "label": "Permanent PIN",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[0-9]{6}$", "message": "PIN must be 6 digits" } ]
      },
      {
        "name": "permanent_city",
        "label": "Permanent City",
        "type": "text",
        "isInput": true
      },
      {
        "name": "permanent_state",
        "label": "Permanent State",
        "type": "text",
        "isInput": true
      },
      {
        "name": "mobile",
        "label": "Mobile",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[0-9]{10}$", "message": "Mobile must be 10 digits" } ]
      },
      {
        "name": "alternate_telephone",
        "label": "Alternate Telephone",
        "type": "text",
        "isInput": true
      },
      {
        "name": "contact_person",
        "label": "Emergency Contact Person",
        "type": "text",
        "isInput": true
      },
      {
        "name": "contact_person_mobile",
        "label": "Contact Person Mobile",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[0-9]{10}$", "message": "Mobile must be 10 digits" } ]
      },
      {
        "name": "contact_person_email",
        "label": "Contact Person Email",
        "type": "email",
        "isInput": true,
        "validations": [ { "rule": "email", "message": "Enter a valid email" } ]
      },
      {
        "name": "pan_no",
        "label": "PAN Number",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[A-Z]{5}[0-9]{4}[A-Z]$", "message": "PAN format AAAAA9999A" } ]
      },
      {
        "name": "aadhar_no",
        "label": "Aadhaar Number",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[0-9]{12}$", "message": "Aadhaar must be 12 digits" } ]
      },
      {
        "name": "passport_no",
        "label": "Passport Number",
        "type": "text",
        "isInput": true
      },
      {
        "name": "driving_lic_no",
        "label": "Driving Licence Number",
        "type": "text",
        "isInput": true
      },
      {
        "name": "pf_no",
        "label": "PF Number",
        "type": "text",
        "isInput": true
      },
      {
        "name": "esic_no",
        "label": "ESIC Number",
        "type": "text",
        "isInput": true
      },
      {
        "name": "bank_account_no",
        "label": "Bank Account Number",
        "type": "text",
        "isInput": true
      },
      {
        "name": "bank_ifsc_code",
        "label": "IFSC Code",
        "type": "text",
        "isInput": true,
        "validations": [ { "rule": "regex", "arg": "^[A-Z]{4}0[A-Z0-9]{6}$", "message": "Enter a valid 11-character IFSC" } ]
      },
      {
        "name": "bank_name",
        "label": "Bank Name",
        "type": "text",
        "isInput": true
      },
      {
        "name": "pan_doc_ref",
        "label": "PAN Document",
        "type": "text",
        "display": true
      },
      {
        "name": "aadhar_doc_ref",
        "label": "Aadhaar Document",
        "type": "text",
        "display": true
      },
      {
        "name": "bank_doc_ref",
        "label": "Bank Document",
        "type": "text",
        "display": true
      },
      {
        "name": "exp_rows",
        "label": "Past Experience Rows",
        "type": "json",
        "display": true,
        "default": []
      },
      {
        "name": "edu_rows",
        "label": "Educational Qualification Rows",
        "type": "json",
        "display": true,
        "default": []
      },
      {
        "name": "fam_rows",
        "label": "Family Details Rows",
        "type": "json",
        "display": true,
        "default": []
      },
      {
        "name": "pay_rows",
        "label": "Candidate Pay Rows",
        "type": "json",
        "display": true,
        "default": []
      }
    ],
    "actions": [
      {
        "id": "act_copy_address",
        "name": "copy_address",
        "description": "Copy current address to permanent",
        "steps": [
          { "kind": "set_input", "name": "permanent_address", "value": "{{current_address}}" },
          { "kind": "set_input", "name": "permanent_pin", "value": "{{current_pin}}" },
          { "kind": "set_input", "name": "permanent_city", "value": "{{current_city}}" },
          { "kind": "set_input", "name": "permanent_state", "value": "{{current_state}}" },
          { "kind": "show_message", "level": "info", "text": "Current address copied to permanent." }
        ]
      },
      {
        "id": "act_save_draft",
        "name": "save_draft",
        "description": "Persist a draft of the onboarding form",
        "steps": [
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/save",
            "body": { "key": "{{access_key}}" },
            "save_response_to": "save_res",
            "on_success": [
              { "kind": "show_message", "level": "success", "text": "Draft saved. You can return to this link and continue later." }
            ],
            "on_error": [
              { "kind": "show_message", "level": "error", "text": "Could not save draft: {{save_res.error}}" }
            ],
            "ioflow_api": "api_api_onboard_save_06f4e4"
          }
        ]
      },
      {
        "id": "act_submit",
        "name": "submit",
        "description": "Final submission of the onboarding form",
        "steps": [
          { "kind": "validate", "names": [ "emp_fname", "emp_lname", "mobile", "pan_no", "aadhar_no", "bank_ifsc_code" ], "on_fail_focus": true },
          {
            "kind": "call_api",
            "method": "POST",
            "url": "/api/onboard/submit",
            "body": { "key": "{{access_key}}" },
            "save_response_to": "submit_res",
            "on_success": [
              { "kind": "show_message", "level": "success", "text": "Thank you! Your details have been submitted. A summary has been emailed to you." }
            ],
            "on_error": [
              { "kind": "show_message", "level": "error", "text": "Submission failed: {{submit_res.error}}" }
            ],
            "ioflow_api": "api_api_onboard_submit_225a6e"
          }
        ]
      }
    ],
    "pageSchemaVersion": 2,
    "sections": [
      {
        "id": "sec_hero",
        "tag": "main",
        "blocks": [
          {
            "id": "hero_main",
            "type": "hero",
            "eyebrow": "Employee Onboarding",
            "title": "Welcome aboard, {{candidate_name}}!",
            "subtitle": "Please complete your onboarding details below. You can save a draft and return any time using the same link until you submit.",
            "align": "center",
            "height": "compact",
            "background": { "kind": "gradient", "gradientFrom": "#0f172a", "gradientTo": "#1e3a8a", "gradientAngle": 135 },
            "textColor": "#ffffff"
          }
        ]
      },
      {
        "id": "sec_gate",
        "tag": "main",
        "blocks": [
          {
            "id": "callout_invalid",
            "type": "callout",
            "variant": "error",
            "title": "Invalid or expired link",
            "body": "This onboarding link is no longer valid — it may have expired, already been submitted, or been entered incorrectly. Please contact your HR team for assistance.",
            "icon": "⚠️",
            "visibility": { "condition": "{{key_valid}} != true" }
          }
        ]
      },
      {
        "id": "sec_form",
        "tag": "main",
        "visibility": { "condition": "{{key_valid}} == true" },
        "blocks": [
          {
            "id": "h_personal",
            "type": "heading",
            "level": 2,
            "text": "Personal Details"
          },
          {
            "id": "form_personal",
            "type": "form",
            "heading": "",
            "layout": "grid",
            "align": "left",
            "submitLabel": "Save Draft",
            "submitAction": "save_draft",
            "fields": [
              { "id": "f_prefix", "name": "name_prefix", "label": "Prefix", "type": "select",
                "options": [ { "label": "Mr.", "value": "MR" }, { "label": "Mrs.", "value": "MRS" }, { "label": "Ms.", "value": "MS" }, { "label": "Dr.", "value": "DR" } ] },
              { "id": "f_fname", "name": "emp_fname", "label": "First Name", "type": "text", "required": true },
              { "id": "f_mname", "name": "emp_mname", "label": "Middle Name", "type": "text" },
              { "id": "f_lname", "name": "emp_lname", "label": "Last Name", "type": "text", "required": true },
              { "id": "f_gender", "name": "gender", "label": "Gender", "type": "select",
                "options": [ { "label": "Male", "value": "M" }, { "label": "Female", "value": "F" }, { "label": "Other", "value": "O" } ] },
              { "id": "f_dob", "name": "birthdate", "label": "Date of Birth", "type": "date" },
              { "id": "f_nat", "name": "nationality", "label": "Nationality", "type": "text" },
              { "id": "f_marital", "name": "marital_status", "label": "Marital Status", "type": "select",
                "options": [ { "label": "Single", "value": "SINGLE" }, { "label": "Married", "value": "MARRIED" }, { "label": "Divorced", "value": "DIVORCED" }, { "label": "Widowed", "value": "WIDOWED" } ] },
              { "id": "f_anniv", "name": "marriage_anniversary", "label": "Marriage Anniversary", "type": "date" },
              { "id": "f_blood", "name": "blood_group", "label": "Blood Group", "type": "select",
                "options": [ { "label": "A+", "value": "A+" }, { "label": "A-", "value": "A-" }, { "label": "B+", "value": "B+" }, { "label": "B-", "value": "B-" }, { "label": "O+", "value": "O+" }, { "label": "O-", "value": "O-" }, { "label": "AB+", "value": "AB+" }, { "label": "AB-", "value": "AB-" } ] },
              { "id": "f_relig", "name": "religion", "label": "Religion", "type": "text" },
