          "joins": {
            "join_predicates": {
              "joins": [
                {
                  "table": "EMPONB_CANDIDATE_SELF",
                  "main_table": true,
                  "table_descr": "Candidate self-service header"
                },
                {
                  "table": "EMPONB_POSITION_MASTER",
                  "main_table": false,
                  "table_descr": "Position master",
                  "column": "POSITION_CODE",
                  "join_table": "EMPONB_CANDIDATE_SELF",
                  "join_column": "POSITION_CODE",
                  "join_type": "left"
                }
              ]
            }
          },
          "list_view": {
            "edit_lock": {
              "expression": "{form.status} == 'Submit'",
              "reason": "You have already submitted this form to HR. It can no longer be changed."
            }
          },
          "actions": [
            {
              "name": "Submit to HR",
              "label": "Submit",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "submit_to_candidate_record",
                "description": "Push captured self-service data to the Candidate Onboarding Record",
                "spec": "For the given CANDIDATE_ID, copy all captured header fields (personal, contact, statutory, financial) from EMPONB_CANDIDATE_SELF onto the matching row of EMPONB_CANDIDATE_RECORD, and replace EMPONB_CAND_EXPERIENCE, EMPONB_CAND_EDUCATION and EMPONB_CAND_FAMILY rows for this CANDIDATE_ID with the current EMPONB_CAND_SELF_EXPERIENCE, EMPONB_CAND_SELF_EDUCATION and EMPONB_CAND_SELF_FAMILY rows respectively. Set EMPONB_CANDIDATE_RECORD.STATUS = 'DataSubmitted', stamp STATUS_DATE and SUBMITTED_ON to now(), invalidate the ACCESS_KEY (KEY_VALID_FLAG = 'N') on both the self and record tables, and return a confirmation message. In the same transaction, also set EMPONB_CANDIDATE_SELF.STATUS = 'Submit' and EMPONB_CANDIDATE_SELF.STATUS_DATE = now() for this CANDIDATE_ID (this is in addition to setting EMPONB_CANDIDATE_RECORD.STATUS = 'DataSubmitted' and stamping SUBMITTED_ON/STATUS_DATE there, and invalidating ACCESS_KEY on both tables as already specified).",
                "language": "plpgsql"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Not already submitted",
                  "message": "This candidate record has already been submitted or confirmed.",
                  "expression": "not in_list({form.status}, \"Submit,DataSubmitted,Review,Confirmed\")"
                }
              ]
            }
          ],
          "validations": [
            {
              "type": "business_logic",
              "name": "Record locked after submission",
              "error_code": "SELF_LOCKED_AFTER_SUBMIT",
              "message": "This record has already been submitted and cannot be changed.",
              "business_logic": {
                "method": "block_edit_after_submit",
                "description": "Prevent any changes to the header once the self record status is Submit",
                "spec": "On save of the header form (add or edit), look up the CURRENTLY STORED STATUS on EMPONB_CANDIDATE_SELF for this CANDIDATE_ID (the value in the database BEFORE this save is applied, not the incoming form value). If the stored STATUS = 'Submit', return an error blocking the save with message 'This record has already been submitted and cannot be changed.'. If no stored row exists yet (first-time add) or stored STATUS is anything else, pass with no error.",
                "language": "plpgsql"
              }
            }
          ]
        }
      },
