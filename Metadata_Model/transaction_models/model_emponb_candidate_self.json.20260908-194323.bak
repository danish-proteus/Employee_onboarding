                    {
                      "data": "Yes",
                      "display": "Married"
                    },
                    {
                      "data": "No",
                      "display": "Unmarried"
                    }
                  ]
                },
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "marriage_anniversary",
                      "expr": "iif({form.marital_status} == \"No\", \"\", {form.marriage_anniversary})"
                    }
                  ],
                  "protect": [
                    {
                      "form_col": "marriage_anniversary",
                      "when": "{form.marital_status} == \"No\""
                    }
                  ]
