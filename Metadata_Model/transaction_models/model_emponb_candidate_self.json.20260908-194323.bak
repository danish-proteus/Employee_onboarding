                    "business_logic": {
                      "method": "check_self_family_member_unique",
                      "description": "Block duplicate family member names for the same candidate",
                      "spec": "Excluding the row being edited when _action = 'edit' (match on CANDIDATE_ID and LINE_NO), check whether another EMPONB_CAND_SELF_FAMILY row for the same CANDIDATE_ID already has the same MEMBER_NAME (case-insensitive, trimmed). If found, return an error: 'Family member ' || MEMBER_NAME || ' is already added. Duplicate member names are not allowed.'",
                      "language": "plpgsql"
                    }
                  }
