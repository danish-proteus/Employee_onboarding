                "item_change": {
                  "mode": "business_logic",
                  "business_logic": {
                    "method": "copy_current_to_permanent_address",
                    "description": "Copy current address to permanent address when checkbox is checked",
                    "spec": "On change of SAME_AS_CURRENT_ADDRESS: if the new value is 'Y', return updates setting permanent_address = current_address, permanent_pin = current_pin, permanent_city = current_city, permanent_state = current_state. If the new value is 'N', return no updates (leave the permanent address fields as the user last entered them for manual editing).",
