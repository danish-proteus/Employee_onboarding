    "cross_updates": [],
    "pre_commit": [],
    "post_commit": [
      {
        "mode": "business_logic",
        "business_logic": {
          "method": "seed_self_experience_from_record",
          "description": "Seed/refresh Past Experience lines from the Candidate Onboarding Record",
          "spec": "After a save of EMPONB_CANDIDATE_SELF (add or edit), when the header's STATUS is 'Link Generated' or 'Link Accessed', copy every EMPONB_CAND_EXPERIENCE row for this CANDIDATE_ID into EMPONB_CAND_SELF_EXPERIENCE for the same CANDIDATE_ID: delete existing EMPONB_CAND_SELF_EXPERIENCE rows for this candidate that no longer correspond to a source row, then upsert (insert/update by LINE_NO) each source row's ORGANISATION, DESIGNATION, FROM_DATE, TO_DATE and GROSS_AMT so the copy is idempotent and safe to run on every resend. When STATUS is 'DataSubmitted', 'Review' or 'Confirmed', do nothing so the candidate's own edits are preserved.",
          "language": "plpgsql"
        }
      }
    ],
    "attach_docs": [],
