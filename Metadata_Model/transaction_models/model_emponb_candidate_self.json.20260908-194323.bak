{
  "transaction": {
    "obj_name": "emponb_candidate_self",
    "sql_models": [
      {
        "sql_model": {
          "form_title": "Candidate Self Onboard",
          "form_descr": "Candidate self-service onboarding form",
          "form_no": "1",
          "main_table": "EMPONB_CANDIDATE_SELF",
          "columns": [
            {
              "column": {
                "name": "candidate_id",
                "db_name": "CANDIDATE_ID",
                "col_type": "VARCHAR",
                "heading": "Candidate ID",
                "descr": "Candidate reference - must exist in Candidate Onboarding Record",
                "group_name": "Basic",
                "key": true,
                "mandatory": true,
                "must_exist_in": "EMPONB_CANDIDATE_RECORD",
                "validations": [
                  {
                    "type": "builtin",
                    "name": "Candidate must exist",
                    "message": "Candidate ID not found in Candidate Onboarding Record.",
                    "builtin": {
                      "kind": "must_exist_in_master",
                      "table": "EMPONB_CANDIDATE_RECORD",
                      "match_column": "candidate_id"
                    }
                  }
                ],
                "item_change": {
                  "mode": "business_logic",
                  "business_logic": {
                    "method": "load_candidate_header",
                    "description": "Load header from self record, fallback to candidate record",
                    "spec": "On change of CANDIDATE_ID: first look up EMPONB_CANDIDATE_SELF for this CANDIDATE_ID; if a row exists, return its fields as updates (candidate_name, email_id, gender, position_code, position_descr, design_code, design_name, and all personal/contact/statutory/financial fields). If no EMPONB_CANDIDATE_SELF row exists yet, fall back to EMPONB_CANDIDATE_RECORD for the same CANDIDATE_ID and return candidate_name, email_id, gender, position_code, position_descr, design_code, design_name and any personal/contact/statutory/financial fields already captured there so the candidate form is pre-populated. If neither exists, return no updates.",
                    "language": "plpgsql"
                  }
                },
                "x": "10",
                "y": "10",
                "col_id": "1",
                "table_name": "EMPONB_CANDIDATE_SELF",
                "table_display_name": "Candidate self-service header",
                "db_size": "10",
                "width": 100,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "candidate_name",
                "db_name": "CANDIDATE_NAME",
                "col_type": "VARCHAR",
                "heading": "Candidate Name",
                "descr": "Candidate full name",
                "group_name": "Basic",
                "mandatory": true,
                "x": "20",
                "y": "20",
                "col_id": "2",
                "table_name": "EMPONB_CANDIDATE_SELF",
                "table_display_name": "Candidate self-service header",
                "db_size": "100",
                "width": 500,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": "",
                "validations": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "email_id",
                "db_name": "EMAIL_ID",
                "col_type": "VARCHAR",
                "heading": "Email ID",
                "descr": "Candidate email address",
                "group_name": "Basic",
                "mandatory": true,
                "validations": [
                  {
                    "type": "expression",
                    "name": "Email format",
                    "message": "Enter a valid email address.",
                    "expression": "match({form.email_id}, \"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}$\")"
                  },
                  {
                    "type": "business_logic",
                    "name": "Email unique on self record",
                    "message": "This email address is already registered for another candidate.",
                    "business_logic": {
                      "method": "check_self_email_unique",
                      "description": "Validate email uniqueness, skip when unchanged in edit mode",
                      "spec": "If _action = 'edit' and the submitted EMAIL_ID equals the EMAIL_ID already stored on this CANDIDATE_ID's EMPONB_CANDIDATE_SELF row, pass (return NULL) without checking. Otherwise check whether EMAIL_ID already exists on any OTHER row of EMPONB_CANDIDATE_SELF (CANDIDATE_ID <> current) or on EMPONB_CANDIDATE_RECORD for a different CANDIDATE_ID; if found, return an error indicating the email address is already registered.",
                      "language": "plpgsql"
                    }
                  }
                ],
                "x": "30",
                "y": "30",
                "col_id": "3",
                "table_name": "EMPONB_CANDIDATE_SELF",
                "table_display_name": "Candidate self-service header",
                "db_size": "120",
                "width": 500,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": "",
                "lookup": ""
              }
            },
