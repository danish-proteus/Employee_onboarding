{
  "table_name": "EMPONB_CANDIDATE_SELF",
  "table_description": "",
  "project": "Employee_onboarding",
  "columns": [
    {
      "column_name": "CANDIDATE_ID",
      "data_type": "VARCHAR",
      "size": "10",
      "key": true,
      "description": "Candidate reference - must exist in Candidate Onboarding Record",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "CANDIDATE_NAME",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Candidate full name",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "EMAIL_ID",
      "data_type": "VARCHAR",
      "size": "120",
      "key": false,
      "description": "Candidate email address",
      "sequence": 3,
      "mandatory": true
    },
    {
      "column_name": "GENDER",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Candidate gender",
      "sequence": 4,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "M",
          "label": "Male"
        },
        {
          "value": "F",
          "label": "Female"
        },
        {
          "value": "O",
          "label": "Other"
        }
      ]
    },
    {
      "column_name": "DESIGN_CODE",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Designation applied for",
      "sequence": 6
    },
    {
      "column_name": "STATUS",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Onboarding status",
      "sequence": 7,
      "allowed_values": [
        {
          "value": "Initiated",
          "label": "Initiated"
        },
        {
          "value": "Link Generated",
          "label": "Link Generated"
        },
        {
          "value": "Link Accessed",
          "label": "Link Accessed"
        },
        {
          "value": "DataSubmitted",
          "label": "Data Submitted"
        },
        {
          "value": "Review",
          "label": "Review"
        },
        {
          "value": "Confirmed",
          "label": "Confirmed"
        },
        {
          "value": "Cancelled",
          "label": "Cancelled"
        },
        {
          "value": "Submit",
          "label": "Submit"
        }
      ]
    },
    {
      "column_name": "STATUS_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Date of last status change",
      "sequence": 8
    },
    {
      "column_name": "INITIATED_BY",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "HR user who initiated the record",
      "sequence": 9
    },
    {
      "column_name": "INITIATED_ON",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Date the record was initiated",
      "sequence": 10
    },
    {
      "column_name": "ACCESS_KEY",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Onboarding link access token",
      "sequence": 11
    },
    {
      "column_name": "KEY_GENERATED_ON",
      "data_type": "DATETIME",
