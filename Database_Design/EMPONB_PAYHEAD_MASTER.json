{
  "table_name": "EMPONB_PAYHEAD_MASTER",
  "table_description": "",
  "project": "Employee_onboarding",
  "columns": [
    {
      "column_name": "AD_CODE",
      "data_type": "CHAR",
      "size": "10",
      "key": true,
      "description": "Unique allowance/deduction (pay head) code.",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "AD_NAME",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Descriptive name of the pay head",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "APPL_MODE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Whether this pay head is an earning or a deduction",
      "sequence": 3,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "Earning",
          "label": "Earning"
        },
        {
          "value": "Deduction",
          "label": "Deduction"
        }
      ]
    },
    {
      "column_name": "AMOUNT_TYPE",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "How the amount for this pay head is determined",
      "sequence": 4,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "Fixed",
          "label": "Fixed"
        },
        {
          "value": "Percentage",
          "label": "Percentage"
        },
        {
          "value": "Formula",
          "label": "Formula"
        }
      ]
    },
    {
      "column_name": "RES_FORMULA",
      "data_type": "VARCHAR",
      "size": "500",
      "key": false,
      "description": "Resolution formula; mandatory when Amount Type = Formula",
      "sequence": 5
    },
    {
      "column_name": "DEFAULT_FREQUENCY",
      "data_type": "VARCHAR",
      "size": "20",
      "key": false,
      "description": "Default payout frequency for this pay head",
      "sequence": 6,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "Monthly",
          "label": "Monthly"
        },
        {
          "value": "Annual",
          "label": "Annual"
        },
        {
          "value": "One-time",
          "label": "One-time"
        }
      ]
    },
    {
      "column_name": "ACTIVE_FLAG",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Whether this pay head is active and selectable",
      "sequence": 7,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "Y",
          "label": "Active"
        },
        {
          "value": "N",
          "label": "Inactive"
        }
      ]
    },
    {
      "column_name": "ADD_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Record creation timestamp",
      "sequence": 8
    },
    {
      "column_name": "ADD_USER",
      "data_type": "VARCHAR",
      "size": "10",
